{
  "name": "image_pair",
  "display_name": "Image pair",
  "is_root": false,
  "is_nestable": true,
  "schema": {
    "images": {
      "type": "bloks",
      "maximum": 2,
      "restrict_components": true,
      "component_whitelist": ["image_item"],
      "pos": 0
    },
    "caption": {
      "type": "text",
      "pos": 1
    },
    "variant": {
      "type": "option",
      "pos": 2,
      "default_value": "equal",
      "options": [
        {
          "name": "Equal",
          "value": "equal"
        },
        {
          "name": "Asymmetric",
          "value": "asymmetric"
        },
        {
          "name": "Asymmetric mirrored",
          "value": "asymmetric-mirrored"
        }
      ]
    },
    "motion": {
      "type": "option",
      "pos": 90,
      "default_value": "default",
      "options": [
        {
          "name": "Default",
          "value": "default"
        },
        {
          "name": "None",
          "value": "none"
        }
      ],
      "description": "Switch animation off for this block."
    }
  }
}
