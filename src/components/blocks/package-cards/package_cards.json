{
  "name": "package_cards",
  "display_name": "Package cards",
  "is_root": false,
  "is_nestable": true,
  "schema": {
    "headline": {
      "type": "text",
      "pos": 0
    },
    "intro": {
      "type": "textarea",
      "pos": 1
    },
    "packages": {
      "type": "options",
      "source": "internal_stories",
      "folder_slug": "packages/",
      "pos": 2
    },
    "motion": {
      "type": "option",
      "pos": 90,
      "default_value": "default",
      "options": [
        {
          "name": "Default",
          "value": "default"
        },
        {
          "name": "None",
          "value": "none"
        }
      ],
      "description": "Switch animation off for this block."
    }
  }
}
