{
  "name": "steffensenfoto",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:bundle": "node scripts/storyblok-schema.mjs",
    "generate:types": "npm run schema:bundle && storyblok-generate-ts source=./storyblok-components.json target=./src/lib/storyblok/generated compilerOptions.unknownAny=true && npm run docs:schema",
    "docs:schema": "npm run schema:bundle && node scripts/generate-schema-docs.mjs",
    "storyblok:login": "node scripts/storyblok.mjs login",
    "storyblok:pull": "node scripts/storyblok.mjs pull",
    "storyblok:import": "node scripts/storyblok.mjs import && npm run generate:types",
    "storyblok:push:dry-run": "node scripts/storyblok.mjs preview",
    "storyblok:push": "node scripts/storyblok.mjs push",
    "test:storyblok": "node --test scripts/storyblok.test.mjs scripts/storyblok-fetch.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@storyblok/react": "^7.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.1",
    "storyblok": "4.25.0",
    "storyblok-generate-ts": "^2.2.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
